# ── Payment Gateway (repo private Gopayment) ──────────────────────────────
# URL domain deployment Gopayment (payment gateway). Contoh: https://gopayment.vercel.app
GOPAYMENT_APP_URL=https://your-gopayment-app.vercel.app

# API key gateway yang sama dengan yang di-set di repo Gopayment (GATEWAY_API_KEY).
# Storefront memakainya untuk membuat sesi QRIS di gateway secara remote.
GATEWAY_API_KEY=replace-with-the-same-gateway-api-key-as-gopayment

# ── Storage (wajib; sama seperti repo Gopayment) ───────────────────────────
# Setup Upstash Redis gratis di https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ── Admin ──────────────────────────────────────────────────────────────────
# Password untuk login /admin-products (kelola produk & stok akun)
ADMIN_PASSWORD=ganti_dengan_password_panjang_dan_unik
