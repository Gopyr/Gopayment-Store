# ── Port & URL ─────────────────────────────────────────────────────────────
PORT=8787
# URL publik app (untuk link pembayaran). Contoh: http://172.235.246.26:8787
APP_URL=http://localhost:8787

# ── Database (SQLite via node:sqlite — TIDAK perlu daftar/database eksternal) ─
# Folder tempat file store.db disimpan. Persisten di VPS.
DATA_DIR=./data

# ── Payment QRIS (meniru gateway Gopayment) ────────────────────────────────
# String QRIS statis (raw text, mulai dari 000201...) — dari merchant QRIS kamu
QRIS_STRING=

# Login merchant GoBiz (GoFood Merchant) untuk polling status pembayaran masuk
GOPAY_EMAIL=
GOPAY_PASSWORD=

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=ganti_password_panjang_dan_unik
